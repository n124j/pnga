# Copy to .env.local and fill in. Nothing here is secret: these values are
# compiled into the public site. NEVER put private API keys in a VITE_ variable.

# The public address of the site, with https and no trailing slash.
# Used for canonical links, the sitemap and social previews.
VITE_SITE_URL=

# Public contact details. Leave blank to hide them on the site.
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# Social profile URLs. Leave blank to hide the icon.
VITE_FACEBOOK_URL=
# Community Facebook group. Defaults to PNGA's group; type off to hide it.
VITE_FACEBOOK_GROUP_URL=
VITE_INSTAGRAM_URL=
VITE_YOUTUBE_URL=

# Nonprofit tax ID (EIN), shown on the Donate page and in the footer once set.
VITE_EIN=

# Hosted donation page (for example Zeffy, Givebutter, PayPal). When set, the
# Donate page shows the button and a "Scan to donate" QR code.
VITE_DONATE_URL=

# Other ways to give. Leave blank to hide the line on the Donate page.
VITE_PAYPAL_URL=
VITE_ZELLE_ID=

# Picture of your Zelle QR code (create it in your bank's Zelle screen), saved in public/images.
# Example: /images/zelle-qr.png. Leave blank to show a "coming soon" box.
VITE_ZELLE_QR_IMAGE=

# Tax wording. Set to true ONLY when PNGA holds an IRS determination letter for 501(c)(3) status.
# This turns on the "tax-deductible" notice on the Donate page and in the footer.
VITE_TAX_EXEMPT=
# Set to true ONLY if PNGA is registered with the Pennsylvania Department of State as a charity.
VITE_PA_CHARITY_REGISTERED=

# EmailJS (contact, help and volunteer forms). Create a free account at emailjs.com.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Community-edited content from Google Sheets. In each sheet: File > Share >
# Publish to the web > choose the "Published" tab and "Comma-separated values
# (.csv)" > Publish, then paste the link here. See README, "Editing news and photos".
VITE_NEWS_CSV_URL=
VITE_GALLERY_CSV_URL=
VITE_EVENTS_CSV_URL=
# Board of directors sheet (one tab called Board; publish that tab).
VITE_BOARD_CSV_URL=
# Programs sheet (one tab called Programs; publish that tab).
VITE_PROGRAMS_CSV_URL=
# Home page slideshow sheet (one tab called Hero; publish that tab).
VITE_HERO_CSV_URL=

# Waivers and sign-up forms (event waiver, volunteer sign-up, photo release).
# Set to true ONLY after the board has approved the wording in data/agreements.ts.
# Until then the pages show a "draft" notice and the Sign buttons are disabled.
VITE_WAIVERS_APPROVED=
# Web address of the Google Apps Script that saves a copy of each form in PNGA's private
# Google Sheet (see README, "Waivers and forms"). Leave blank to use email only.
VITE_FORMS_WEBHOOK_URL=
